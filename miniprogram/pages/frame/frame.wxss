page {
  --bf-page: #f1eee7;
  --bf-surface: #fbf9f4;
  --bf-surface-muted: #e9e4da;
  --bf-stage: #1b1a17;
  --bf-stage-raised: #272520;
  --bf-ink: #292721;
  --bf-muted: #736d62;
  --bf-line: #d8d0c3;
  --bf-line-strong: #bfb5a5;
  --bf-accent: #9e4f2b;
  --bf-accent-soft: #f3e2d9;
  --bf-danger: #a83232;
}

.workspace {
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--bf-page);
  color: var(--bf-ink);
}

.top-bar {
  flex: 0 0 54px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  box-sizing: border-box;
  background: rgba(251,249,244,.96);
  border-bottom: 1px solid var(--bf-line);
}
.top-title { display: flex; align-items: baseline; gap: 8px; }
.app-name { font-size: 15px; font-weight: 600; letter-spacing: .04em; }
.selection-count { color: var(--bf-muted); font-size: 12px; }

.btn {
  min-height: 40px;
  padding: 0 15px;
  border: 1px solid transparent;
  border-radius: 8px;
  font-size: 13px;
  line-height: 40px;
  box-sizing: border-box;
}
.btn::after { border: 0; }
.btn.primary { color: #fffaf4; background: var(--bf-accent); }
.btn.ghost { color: var(--bf-ink); background: transparent; border-color: var(--bf-line-strong); }
.btn:active { opacity: .78; }
.compact-btn { min-height: 36px; line-height: 36px; padding: 0 13px; }
.mini-btn { min-width: 36px; padding: 0 8px; }

.preview-stage {
  position: relative;
  flex: 1 1 auto;
  min-height: 128px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 14px;
  box-sizing: border-box;
  background: var(--bf-stage);
}
.preview-frame {
  position: relative;
  max-width: 100%;
  max-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,250,240,.2);
  background: var(--bf-stage-raised);
}
.preview-badge {
  position: absolute;
  right: 9px;
  top: 9px;
  padding: 4px 7px;
  border-radius: 999px;
  color: #fffaf4;
  background: rgba(28,27,24,.78);
  font-size: 11px;
}
.empty-preview { position: absolute; width: 238px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
.empty-title { color: #fffaf4; font-size: 17px; font-weight: 600; letter-spacing: .03em; }
.empty-copy { color: #c9c1b3; font-size: 12px; line-height: 1.55; }

.thumbnail-strip {
  flex: 0 0 70px;
  width: 100%;
  white-space: nowrap;
  padding: 8px 13px;
  box-sizing: border-box;
  background: var(--bf-surface);
  border-bottom: 1px solid var(--bf-line);
}
.thumbnail-wrap { position: relative; display: inline-block; margin-right: 8px; }
.thumbnail { display: block; width: 54px; height: 54px; border: 2px solid transparent; border-radius: 3px; box-sizing: border-box; background: var(--bf-surface-muted); }
.thumbnail.active { border-color: var(--bf-accent); }
.security-dot { position: absolute; right: 3px; top: 3px; width: 14px; height: 14px; border-radius: 50%; color: #fff; text-align: center; font-size: 9px; line-height: 14px; }
.security-dot.checking { background: #b77b22; animation: security-pulse 1s ease-in-out infinite; }
.security-dot.rejected { background: var(--bf-danger); }
.security-dot.error { background: #b77b22; }
@keyframes security-pulse { 50% { opacity: .38; } }

.tool-tabs {
  flex: 0 0 50px;
  display: flex;
  align-items: stretch;
  padding: 0 12px;
  box-sizing: border-box;
  background: var(--bf-surface);
  border-bottom: 1px solid var(--bf-line);
}
.tool-tab { flex: 1; display: flex; align-items: center; justify-content: center; color: var(--bf-muted); font-size: 13px; border-bottom: 2px solid transparent; }
.tool-tab.active { color: var(--bf-accent); font-weight: 600; border-bottom-color: var(--bf-accent); }
.panel-toggle { flex: 0 0 42px; display: flex; align-items: center; justify-content: center; }
.panel-toggle-icon { width: 8px; height: 8px; border-right: 1px solid var(--bf-muted); border-bottom: 1px solid var(--bf-muted); transform: rotate(45deg) translateY(-2px); transition: transform .18s ease; }
.panel-toggle-icon.up { transform: rotate(225deg) translateY(-2px); }

.setting-sheet { flex: 0 1 31vh; min-height: 124px; max-height: 248px; overflow: hidden; background: var(--bf-surface); transition: flex-basis .18s ease; }
.setting-sheet.collapsed { flex: 0 0 0; min-height: 0; max-height: 0; }
.setting-scroll { height: 100%; box-sizing: border-box; }
.tool-panel { padding: 13px 16px 16px; box-sizing: border-box; }
.panel-heading { margin-bottom: 12px; color: var(--bf-ink); font-size: 15px; font-weight: 600; letter-spacing: .02em; }
.frame-group-title { margin: 11px 0 7px; color: var(--bf-muted); font-size: 11px; letter-spacing: .09em; }
.structured-frame-options, .picture-adjustment { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--bf-line); }
.panel-hint { margin-top: 9px; color: var(--bf-muted); font-size: 11px; line-height: 1.45; }
.field-label { display: block; margin-bottom: 8px; color: var(--bf-muted); font-size: 11px; letter-spacing: .04em; }
.chip-row, .template-list, .frame-style-list { white-space: nowrap; }
.choice-chip, .value-chip { display: inline-flex; align-items: center; justify-content: center; min-height: 32px; margin-right: 7px; padding: 0 11px; border: 1px solid var(--bf-line); border-radius: 7px; color: var(--bf-muted); background: var(--bf-surface); font-size: 12px; box-sizing: border-box; }
.choice-chip.active, .value-chip.active { color: var(--bf-accent); border-color: var(--bf-accent); background: var(--bf-accent-soft); font-weight: 600; }
.setting-row { display: flex; align-items: center; justify-content: space-between; min-height: 42px; color: var(--bf-ink); font-size: 13px; }
.inline-actions { display: flex; align-items: center; gap: 6px; }
.muted { color: var(--bf-muted); }
.small-input { width: 48px; height: 32px; padding: 0 5px; color: var(--bf-ink); background: var(--bf-surface); border: 1px solid var(--bf-line-strong); border-radius: 7px; text-align: center; font-size: 12px; box-sizing: border-box; }
.strength-row { display: flex; }

.template-card { display: inline-flex; width: 88px; margin-right: 8px; padding: 0; flex-direction: column; gap: 5px; color: var(--bf-muted); background: transparent; box-sizing: border-box; font-size: 10px; }
.frame-style-card { display: inline-flex; width: 136px; margin-right: 9px; padding: 6px; flex-direction: column; gap: 6px; border: 1px solid var(--bf-line); border-radius: 7px; color: var(--bf-muted); background: var(--bf-surface); box-sizing: border-box; font-size: 11px; }
.basic-frame-card { width: 88px; margin-right: 8px; padding: 0; gap: 5px; border: 0; border-radius: 0; background: transparent; font-size: 10px; }
.template-card.active, .frame-style-card.active { color: var(--bf-ink); }
.template-card.active .template-preview { border-color: var(--bf-accent); box-shadow: inset 0 0 0 1px var(--bf-accent); }
.frame-style-card.active:not(.basic-frame-card) { border-color: var(--bf-accent); box-shadow: inset 0 0 0 1px var(--bf-accent); }
.basic-frame-card.active .frame-card-sample { border-color: var(--bf-accent); box-shadow: inset 0 0 0 1px var(--bf-accent); }
.template-preview { position: relative; height: 48px; overflow: hidden; border: 1px solid var(--bf-line); background: #eee9df; box-sizing: border-box; }
.frame-card-sample { position: relative; height: 82px; overflow: hidden; background: #eee9df; }
.basic-frame-card .frame-card-sample { height: 48px; border: 1px solid var(--bf-line); box-sizing: border-box; }
.template-preview.dark { background: #20201d; }
.template-photo, .frame-card-photo { position: absolute; left: 22%; top: 13%; width: 56%; height: 74%; background: linear-gradient(135deg,#a8a39a 0 35%,#737b73 36% 65%,#c4a782 66%); }
.template-edge { position: absolute; left: 19%; top: 10%; width: 62%; height: 80%; border: 2px solid #050505; box-sizing: border-box; }
.frame-card-edge { position: absolute; left: 19%; top: 10%; width: 62%; height: 80%; border: 2px solid #050505; box-sizing: border-box; }
.frame-card-sample.none .frame-card-edge { display: none; }
.frame-card-sample.full-frame-scan .frame-card-edge { border-width: 2px 2px 3px; transform: rotate(-.4deg); }
.frame-card-sample.scan-emulsion-edge .frame-card-edge { border-width: 2px 1px 3px; }
.frame-card-sample.scan-emulsion-edge::before { content: ''; position: absolute; left: 18%; top: 6%; width: 64%; height: 2px; background: repeating-linear-gradient(90deg,#d8be78 0 7px,transparent 7px 13px,#b9954c 13px 17px,transparent 17px 25px); opacity: .9; }
.frame-card-sample.scan-emulsion-edge::after { content: ''; position: absolute; left: 18%; bottom: 5%; width: 64%; height: 3px; background: repeating-linear-gradient(90deg,#b9954c 0 8px,transparent 8px 13px,#e4d09a 13px 19px,transparent 19px 26px); opacity: .92; }
.frame-card-sample.film-gate .frame-card-edge { left: 17%; top: 8%; width: 64%; height: 83%; border-width: 2px 3px 5px 4px; }
.frame-card-sample.emulsion-damage .frame-card-edge { border-width: 3px; border-style: dashed; }
.frame-card-sample.film-strip-35mm-full .frame-card-edge { left: 17%; top: 5%; width: 66%; height: 90%; border-width: 8px 2px; }
.frame-card-sample.film-strip-35mm-full::before, .frame-card-sample.film-strip-35mm-full::after { content: ''; position: absolute; left: 20%; width: 60%; height: 3px; background: repeating-linear-gradient(90deg,#eee9df 0 5px,transparent 5px 9px); z-index: 2; }
.frame-card-sample.film-strip-35mm-full::before { top: 8%; }
.frame-card-sample.film-strip-35mm-full::after { bottom: 8%; }
.frame-card-sample.film-rebate-minimal .frame-card-edge { border-width: 3px; }

.compact-colors { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
.color-item { width: 25px; height: 25px; border: 2px solid transparent; border-radius: 50%; box-sizing: border-box; }
.color-item.active { border-color: var(--bf-accent); box-shadow: 0 0 0 2px var(--bf-accent-soft); }
.custom-color { display: flex; align-items: center; justify-content: center; color: var(--bf-ink); background: var(--bf-surface-muted); border-style: dashed; font-size: 16px; }
.adjustment-heading, .adjustment-footer { display: flex; align-items: center; justify-content: space-between; }
.adjustment-heading { color: var(--bf-ink); font-size: 13px; }
.setting-value { color: var(--bf-accent); font-size: 12px; font-weight: 600; }
.adjustment-footer .panel-hint { margin: 0; }
.text-action { min-height: 32px; margin: 0; padding: 0 4px; color: var(--bf-accent); background: transparent; font-size: 12px; line-height: 32px; }
.text-action::after { border: 0; }

.bottom-actions { flex: 0 0 66px; padding: 10px 16px; box-sizing: border-box; background: var(--bf-surface); border-top: 1px solid var(--bf-line); }
.export-btn { width: 100%; min-height: 44px; line-height: 44px; background: var(--bf-accent); letter-spacing: .03em; }
.export-btn[disabled] { color: #8c857b; background: var(--bf-surface-muted); }

.color-picker-modal { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; }
.color-picker-mask { position: absolute; inset: 0; background: rgba(24,23,20,.52); }
.color-picker-content { position: relative; width: 100%; max-height: 55vh; padding: 16px; color: var(--bf-ink); background: var(--bf-surface); border-radius: 14px 14px 0 0; box-sizing: border-box; }
.color-picker-header, .color-picker-footer, .color-preview-section { display: flex; align-items: center; justify-content: space-between; }
.color-picker-title { font-size: 15px; font-weight: 600; }
.color-picker-body { padding: 15px 0; }
.color-preview-box { width: 30px; height: 30px; margin-right: 8px; border: 1px solid var(--bf-line); border-radius: 5px; }
.color-picker-footer { gap: 8px; }
.color-picker-footer .btn { flex: 1; }

<view class="workspace">
  <view class="top-bar">
    <view class="top-title" wx:if="{{images.length}}">
      <text class="app-name">已选照片</text>
      <text class="selection-count" wx:if="{{images.length}}">{{images.length}} 张</text>
    </view>
    <button class="btn primary compact-btn" bindtap="chooseImages">{{images.length?'添加照片':'选择照片'}}</button>
  </view>

  <view class="preview-stage">
    <view class="preview-frame">
      <canvas type="2d" id="preview"
              style="width: {{displayWidth}}px; height: {{displayHeight}}px; background: {{canvasBg}};"
              width="{{previewW}}" height="{{previewH}}"></canvas>
      <view class="preview-badge" wx:if="{{showZoomBadge}}">{{imageZoomPct}}%</view>
      <view class="empty-preview" wx:if="{{!images.length}}">
        <text class="empty-title">批量统一照片版式</text>
        <text class="empty-copy">选择照片后，用外层留白和内层边框做一组统一装裱。</text>
        <button class="btn primary" bindtap="chooseImages">选择照片</button>
      </view>
    </view>
  </view>

  <scroll-view class="thumbnail-strip" scroll-x wx:if="{{images.length}}">
    <view wx:for="{{images}}" wx:key="id" class="thumbnail-wrap">
      <image src="{{item.path}}" class="thumbnail {{index===curIndex?'active':''}}"
             mode="aspectFill" bindtap="onPickIndex" data-idx="{{index}}"/>
      <view wx:if="{{item.securityStatus==='checking'}}" class="security-dot checking"></view>
      <view wx:if="{{item.securityStatus==='rejected'}}" class="security-dot rejected">!</view>
      <view wx:if="{{item.securityStatus==='error'}}" class="security-dot error">?</view>
    </view>
  </scroll-view>

  <view class="tool-tabs">
    <view wx:for="{{toolOptions}}" wx:key="*this"
          class="tool-tab {{activeTool===item?'active':''}}"
          data-tool="{{item}}" bindtap="onToolTap">
      <text wx:if="{{item==='template'}}">模板</text>
      <text wx:if="{{item==='canvas'}}">画面</text>
      <text wx:if="{{item==='frame'}}">内框</text>
    </view>
    <view class="panel-toggle" bindtap="togglePanel">
      <view class="panel-toggle-icon {{panelExpanded?'up':''}}"></view>
    </view>
  </view>

  <view class="setting-sheet {{panelExpanded?'expanded':'collapsed'}}">
    <scroll-view class="setting-scroll" scroll-y scroll-top="{{panelScrollTop}}">
      <view wx:if="{{activeTool==='template'}}" class="tool-panel">
        <view class="panel-heading">模板</view>
        <scroll-view class="template-list" scroll-x>
          <view wx:for="{{templates}}" wx:key="id"
                class="template-card {{innerFrameStyleId===item.styleId && outerBgColor===item.outerBgColor?'active':''}}"
                data-template-id="{{item.id}}" bindtap="onTemplateTap">
            <view class="template-preview {{item.outerBgColor==='#000000'?'dark':''}}">
              <view class="template-photo"></view>
              <view class="template-edge"></view>
            </view>
            <text>{{item.name}}</text>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{activeTool==='canvas'}}" class="tool-panel">
        <view class="panel-heading">画面</view>
        <text class="field-label">输出比例</text>
        <scroll-view class="chip-row" scroll-x>
          <view wx:for="{{ratioOptions}}" wx:key="*this"
                class="choice-chip {{ratioIdx===index?'active':''}}"
                data-idx="{{index}}" bindtap="onRatioChip">{{item}}</view>
        </scroll-view>
        <view class="setting-row">
          <text>方向</text>
          <view class="inline-actions">
            <button class="btn ghost mini-btn" bindtap="toggleOrientation">{{isLandscape?'横向':'纵向'}}</button>
            <picker mode="selector" range="{{sizePresets}}" value="{{sizeIdx}}" bindchange="onSizePick">
              <view class="value-chip">长边 {{sizePresets[sizeIdx]}}px</view>
            </picker>
          </view>
        </view>
        <view class="setting-row">
          <text>外层背景</text>
          <switch checked="{{enableOuterBg}}" bindchange="toggleOuterBg" color="#9E4F2B"/>
        </view>
        <view class="color-options compact-colors" wx:if="{{enableOuterBg}}">
          <view wx:for="{{colorPresets}}" wx:key="*this" wx:for-item="color"
                class="color-item {{outerBgColor===color?'active':''}}"
                style="background:{{color}}" data-color="{{color}}" bindtap="selectOuterColor"></view>
          <view class="color-item custom-color" bindtap="openColorPicker" data-type="outer">+</view>
        </view>
        <view class="picture-adjustment" wx:if="{{images.length}}">
          <view class="adjustment-heading">
            <text>图片缩放</text>
            <text class="setting-value">{{imageZoomPct}}%</text>
          </view>
          <slider min="50" max="200" step="1" value="{{imageZoomPct}}"
                  bindchanging="onImageZoomChanging" bindchange="onImageZoomChange"
                  activeColor="#9E4F2B" backgroundColor="#D8D0C3" block-color="#9E4F2B"/>
          <view class="adjustment-footer">
            <text class="panel-hint">缩小或放大当前照片</text>
            <button class="text-action" bindtap="resetCurrentImageZoom">恢复</button>
          </view>
        </view>
      </view>

      <view wx:if="{{activeTool==='frame'}}" class="tool-panel">
        <view class="panel-heading">内框</view>
        <view class="frame-group-title">基础内框</view>
        <scroll-view class="frame-style-list" scroll-x>
            <view wx:for="{{basicFrameStyles}}" wx:key="id"
                  class="frame-style-card basic-frame-card {{innerFrameStyleId===item.id?'active':''}}"
                  data-style-id="{{item.id}}" bindtap="onInnerFrameStyleTap">
            <view class="frame-card-sample {{item.id}}">
              <view class="frame-card-photo"></view>
              <view class="frame-card-edge"></view>
            </view>
            <text>{{item.name}}</text>
          </view>
        </scroll-view>
        <view class="frame-group-title">片基内框</view>
        <scroll-view class="frame-style-list" scroll-x>
          <view wx:for="{{filmRebateStyles}}" wx:key="id"
                class="frame-style-card {{innerFrameStyleId===item.id?'active':''}}"
                data-style-id="{{item.id}}" bindtap="onInnerFrameStyleTap">
            <view class="frame-card-sample {{item.id}}">
              <view class="frame-card-photo"></view>
              <view class="frame-card-edge"></view>
            </view>
            <text>{{item.name}}</text>
          </view>
        </scroll-view>
        <view class="setting-row" wx:if="{{innerFrameStyleId!=='none' && !currentStyleIsStructured}}">
          <text>内框宽度</text>
          <view class="inline-actions">
            <button class="btn ghost mini-btn" bindtap="decBorder">－</button>
            <input class="small-input" type="digit" value="{{borderPx}}" bindinput="onBorderInput" bindblur="onBorderBlur"/>
            <button class="btn ghost mini-btn" bindtap="incBorder">＋</button>
          </view>
        </view>
        <view wx:if="{{currentStyleSupportsStrength}}">
          <text class="field-label">边缘强度</text>
          <view class="strength-row">
            <view wx:for="{{edgeStrengthOptions}}" wx:key="id"
                  class="choice-chip {{edgeStrengthLevel===item.id?'active':''}}"
                  data-level="{{item.id}}" bindtap="onEdgeStrengthTap">{{item.name}}</view>
          </view>
        </view>
        <view class="setting-row" wx:if="{{currentStyleSupportsColor}}">
          <text>内框颜色</text>
          <view class="color-options compact-colors">
            <view wx:for="{{colorPresets}}" wx:key="*this" wx:for-item="color"
                  class="color-item {{innerBorderColor===color?'active':''}}"
                  style="background:{{color}}" data-color="{{color}}" bindtap="selectInnerColor"></view>
            <view class="color-item custom-color" bindtap="openColorPicker" data-type="inner">+</view>
          </view>
        </view>
        <view wx:if="{{currentStyleIsStructured && currentStyleSupportsFrameSize}}" class="structured-frame-options">
          <view class="field-label">片基尺寸</view>
          <view class="strength-row">
            <view wx:for="{{frameSizeOptions}}" wx:key="id"
                  class="choice-chip {{frameSizePreset===item.id?'active':''}}"
                  data-preset="{{item.id}}" bindtap="onFrameSizePresetTap">{{item.name}}</view>
          </view>
          <view class="setting-row" wx:if="{{currentStyleSupportsPerforations}}"><text>齿孔</text><switch checked="{{framePerforationsEnabled}}" bindchange="toggleFramePerforations" color="#9E4F2B"/></view>
          <view class="setting-row" wx:if="{{currentStyleSupportsEdgeLabel}}"><text>边码</text><switch checked="{{frameEdgeLabelEnabled}}" bindchange="toggleFrameEdgeLabel" color="#9E4F2B"/></view>
          <view class="setting-row" wx:if="{{currentStyleSupportsFrameNumber}}"><text>帧号</text><switch checked="{{frameNumberEnabled}}" bindchange="toggleFrameNumber" color="#9E4F2B"/></view>
          <view class="setting-row" wx:if="{{currentStyleSupportsMarkers}}"><text>角标</text><switch checked="{{frameMarkersEnabled}}" bindchange="toggleFrameMarkers" color="#9E4F2B"/></view>
        </view>
        <view class="setting-row">
          <text>启用内框</text>
          <switch checked="{{enableInnerBorder}}" bindchange="toggleInnerBorder" color="#9E4F2B"/>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="bottom-actions" wx:if="{{images.length}}">
    <button class="btn export-btn" bindtap="exportAll" disabled="{{exporting}}">
      <text wx:if="{{exporting}}">处理中 {{progressCur}}/{{progressTotal}}</text>
      <text wx:else>批量导出 {{images.length}} 张</text>
    </button>
  </view>

  <view class="color-picker-modal" wx:if="{{showColorPicker}}">
    <view class="color-picker-mask" bindtap="closeColorPicker"></view>
    <view class="color-picker-content">
      <view class="color-picker-header"><text class="color-picker-title">自定义颜色</text><view bindtap="closeColorPicker">×</view></view>
      <view class="color-picker-body">
        <view class="color-preview-section"><view class="color-preview-box" style="background:{{currentPickerColor}}"></view><text>{{currentPickerColor}}</text></view>
        <slider min="0" max="360" value="{{hue}}" bindchange="onHueChange" activeColor="#9E4F2B"/>
        <slider min="0" max="100" value="{{saturation}}" bindchange="onSaturationChange" activeColor="#9E4F2B"/>
        <slider min="0" max="100" value="{{lightness}}" bindchange="onLightnessChange" activeColor="#9E4F2B"/>
      </view>
      <view class="color-picker-footer"><button class="btn ghost" bindtap="closeColorPicker">取消</button><button class="btn primary" bindtap="confirmColorPicker">确定</button></view>
    </view>
  </view>
</view>

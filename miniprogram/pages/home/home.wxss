page { background: var(--bf-page); color: var(--bf-ink); }
.home {
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 0 24px calc(24px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bf-page);
}
.home-hero { flex: 0 0 auto; }
.brand { display: block; margin-bottom: 12px; color: var(--bf-accent); font-size: 11px; font-weight: 600; letter-spacing: .18em; }
.title { display: block; color: var(--bf-ink); font-size: 30px; font-weight: 600; line-height: 1.16; letter-spacing: .01em; }
.subtitle { display: block; margin-top: 12px; color: var(--bf-muted); font-size: 13px; line-height: 1.62; }
.specimen { flex: 1 1 auto; min-height: 0; display: flex; align-items: center; padding: 24px 0; box-sizing: border-box; }
.specimen-stage { width: 100%; height: min(39vh, 286px); min-height: 216px; display: flex; align-items: center; justify-content: center; padding: 24px; box-sizing: border-box; background: var(--bf-stage); }
.specimen-preview { width: 100%; height: 100%; display: block; }
.home-actions { flex: 0 0 auto; display: flex; flex-direction: column; align-items: stretch; }
.primary-action { min-height: 50px; color: #FFF9F4; background: var(--bf-accent); border-radius: 10px; font-size: 15px; font-weight: 600; line-height: 50px; letter-spacing: .02em; }
.primary-action::after { border: 0; }
.action-note { margin-top: 9px; color: var(--bf-muted); font-size: 11px; text-align: center; }

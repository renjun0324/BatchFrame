page { background: #f1eee7; color: #292721; }
.home { min-height: 100vh; box-sizing: border-box; padding: 42px 24px calc(34px + env(safe-area-inset-bottom)); background: #f1eee7; }
.hero { max-width: 318px; }
.eyebrow { display: block; margin-bottom: 13px; color: #9e4f2b; font-size: 11px; font-weight: 600; letter-spacing: .18em; }
.title { display: block; color: #292721; font-size: 29px; font-weight: 600; line-height: 1.18; letter-spacing: .02em; }
.subtitle { display: block; margin-top: 13px; color: #706a60; font-size: 14px; line-height: 1.65; }
.specimen { margin: 36px 0 32px; padding: 18px; background: #1b1a17; }
.specimen-canvas { position: relative; height: 235px; display: flex; align-items: center; justify-content: center; background: #ede8df; }
.specimen-frame { width: 68%; height: 61%; padding: 8px; box-sizing: border-box; background: #080807; }
.specimen-photo { width: 100%; height: 100%; background: linear-gradient(145deg,#c5b69e 0 34%,#83908a 35% 62%,#a46646 63%); }
.home-actions { display: flex; flex-direction: column; align-items: stretch; }
.primary-action { min-height: 48px; color: #fffaf4; background: #9e4f2b; border-radius: 8px; font-size: 15px; line-height: 48px; letter-spacing: .04em; }
.primary-action::after { border: 0; }
.action-note { margin-top: 10px; color: #8a8378; font-size: 11px; text-align: center; }
.feature-list { margin-top: 38px; border-top: 1px solid #d8d0c3; }
.feature-item { display: flex; gap: 14px; align-items: center; min-height: 48px; border-bottom: 1px solid #d8d0c3; color: #514d46; font-size: 13px; }
.feature-index { width: 22px; color: #9e4f2b; font-size: 11px; font-weight: 600; }

<view class="home" style="padding-top: {{topInset}}px;">
  <view class="home-header">
    <text class="wordmark">BatchFrame</text>
  </view>

  <view class="home-hero">
    <image
      class="hero-image"
      src="/assets/home/home-hero.png"
      mode="widthFix"
      aria-label="暖调胶片装裱效果"
    />
  </view>

  <view class="home-actions">
    <button class="primary-action" bindtap="goToFrame">选择照片</button>
    <text class="action-note">最多 9 张</text>
  </view>
</view>
